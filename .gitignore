# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Docker / local runtime data
*.log
logs/
.tmp/
.temp/

# Test coverage / build output
coverage/
*.coverage

# Optional: keep env files out
.env
.env.*
!.env.example
